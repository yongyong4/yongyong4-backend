# 배포 서버용 환경변수. deploy/.env 로 복사해 값을 채운다 (git 제외)
# deploy.sh 가 최초 1회 /opt/yongyong/.env 로 올린다

# 서비스 DB (install.sh 가 이 계정으로 yongyong DB를 만든다. 영문·숫자·._@%+=- 만)
MYSQL_USER=yongyong
MYSQL_PASSWORD=

# 외부 API 키
ODSAY_API_KEY=
KAKAO_REST_API_KEY=
GBIS_API_KEY=
OPENAI_API_KEY=

# 수집 서버 · 예측 서버 (예측 서버는 같은 VM)
COLLECTOR_BASE_URL=http://<수집서버주소>:8080
PREDICT_BASE_URL=http://127.0.0.1:8000
